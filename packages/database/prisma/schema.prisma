generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis(version: "3.4")]
}

enum Role {
  CITIZEN
  VOLUNTEER
  ADMIN
  COORD_LOCAL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum RequestState {
  REQUESTED
  WAITING_VOLUNTEER
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  VERIFICATION_PENDING
  NOTE_PENDING
  COMPLETED
  CANCELLED
  REASSIGNMENT_REQUIRED
}

enum ZoneStatus {
  SAFE
  CAUTION
  DANGEROUS
}

model Users {
  id                String              @id @default(uuid())
  phone_number      String              @unique
  role              Role                @default(CITIZEN)
  status            UserStatus          @default(ACTIVE)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  VolunteerProfile  VolunteerProfiles?
  property_requests PropertyRequests[]
}

// Voluntarios de acompañamiento comunitario: sin cruce contra COPNIA/CPNAA,
// solo cedula + profesion auto-declarada. No emiten dictamenes oficiales.
model VolunteerProfiles {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  id_document_number  String   @unique
  declared_profession String
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  user                Users    @relation(fields: [user_id], references: [id])
  visits              Visits[]
}

model PropertyRequests {
  id               String       @id @default(uuid())
  citizen_id       String
  geom             Unsupported("geography(Point, 4326)")
  structural_type  String
  damages_json     Json
  priority_score   Int          @default(0)
  state            RequestState @default(REQUESTED)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  citizen          Users        @relation(fields: [citizen_id], references: [id])
  visits           Visits[]
}

model Visits {
  id               String   @id @default(uuid())
  request_id       String
  volunteer_id     String
  otp_hash         String
  checkin_location Unsupported("geography(Point, 4326)")?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  request          PropertyRequests  @relation(fields: [request_id], references: [id])
  volunteer        VolunteerProfiles @relation(fields: [volunteer_id], references: [id])
  visit_note       VisitNotes?
}

// Nota informal de acompañamiento (no un dictamen oficial): por zonas/
// habitaciones, cada una con su propio estado y comentario, mas un campo
// de comentarios generales de la visita completa.
model VisitNotes {
  id               String   @id @default(uuid())
  visit_id         String   @unique
  general_comments String?
  evidence_urls    Json
  created_at       DateTime @default(now())

  visit            Visits           @relation(fields: [visit_id], references: [id])
  zones            VisitNoteZones[]
}

model VisitNoteZones {
  id            String     @id @default(uuid())
  visit_note_id String
  zone_name     String
  status        ZoneStatus
  comment       String?

  visit_note    VisitNotes @relation(fields: [visit_note_id], references: [id])
}

model AuditLogs {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  actor_id    String
  action      String
  resource_id String
  prior_state String?
  new_state   String?
  ip_address  String?
}
