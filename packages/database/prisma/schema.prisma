generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [postgis(version: "3.3.7")]
}

enum Role {
  CITIZEN
  VOLUNTEER
  ADMIN
  COORD_LOCAL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

// Estado de la revision manual del admin. PENDING no bloquea: el
// analista puede operar desde que se registra (decision de producto:
// tras un sismo la velocidad importa mas que el tramite). Lo que cambia
// es que el ciudadano solo ve el distintivo "Verificado" si el admin ya
// reviso la matricula.
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum RequestState {
  REQUESTED
  WAITING_VOLUNTEER
  ASSIGNED
  SCHEDULED
  IN_PROGRESS
  VERIFICATION_PENDING
  NOTE_PENDING
  COMPLETED
  CANCELLED
  REASSIGNMENT_REQUIRED
}

enum AbuseReason {
  PIDIO_DINERO
  PIDIO_DATOS_PERSONALES
  TRATO_IRRESPETUOSO
  NO_LLEGO
  SOSPECHOSO
  OTRO
}

enum ZoneStatus {
  SAFE
  CAUTION
  DANGEROUS
}

enum HousingType {
  CASA
  APARTAMENTO
}

enum Profession {
  ARQUITECTO
  INGENIERO_CIVIL
  INGENIERO_CIVIL_ESTRUCTURAS
  INGENIERO_GEOTECNISTA
  CONSTRUCTOR
  TECNOLOGO_OBRAS_CIVILES
  TECNICO_CONSTRUCCION
  MAESTRO_DE_OBRA
  ESTUDIANTE_ARQUITECTURA_INGENIERIA_CIVIL
  OTRO
}

model Users {
  id                String              @id @default(uuid())
  phone_number      String              @unique
  role              Role                @default(CITIZEN)
  status            UserStatus          @default(ACTIVE)
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt

  // Habeas data (Ley 1581 de 2012): se guarda cuando y que version de
  // la politica acepto, porque la autorizacion debe poder demostrarse.
  data_consent_at      DateTime?
  data_consent_version String?

  VolunteerProfile  VolunteerProfiles?
  property_requests PropertyRequests[]
  messages          Messages[]
}

// Voluntarios de acompañamiento comunitario: sin cruce contra COPNIA/CPNAA,
// solo cedula + profesion auto-declarada. No emiten dictamenes oficiales.
model VolunteerProfiles {
  id                  String     @id @default(uuid())
  user_id             String     @unique
  full_name           String
  id_document_number  String     @unique
  declared_profession Profession
  // Matricula/tarjeta profesional (COPNIA o CPNAA). Solo se pide a las
  // profesiones universitarias que la tienen, y es dato interno: se
  // guarda para verificacion manual del admin, nunca se le muestra al
  // ciudadano ni viaja en respuestas publicas.
  professional_license String?
  photo_url           String
  is_active           Boolean    @default(true)
  verification_status VerificationStatus @default(PENDING)
  verified_at         DateTime?
  // Usuario admin que hizo la revision, y por que se rechazo. Ambos son
  // datos internos: al ciudadano solo le llega si esta verificado o no.
  reviewed_by         String?
  review_notes        String?
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  user                Users      @relation(fields: [user_id], references: [id])
  visits              Visits[]
  admin_notices       AdminNotices[]
}

model PropertyRequests {
  id              String       @id @default(uuid())
  citizen_id      String
  geom            Unsupported("geography(Point, 4326)")
  reporter_name   String
  address_text    String
  // Torre/bloque y apartamento, o el complemento de una casa. Sin esto
  // el analista llega al edificio pero no sabe a que puerta tocar.
  address_complement String?
  housing_type    HousingType
  damages_json    Json
  priority_score  Int          @default(0)
  state           RequestState @default(REQUESTED)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  citizen         Users        @relation(fields: [citizen_id], references: [id])
  visits          Visits[]
}

model Visits {
  id               String   @id @default(uuid())
  request_id       String
  volunteer_id     String
  otp_hash         String
  // El ciudadano necesita poder leer su PIN en pantalla para dictarselo
  // al voluntario en persona; el hash se conserva para la verificacion.
  // Este campo NUNCA se expone al voluntario.
  pin_code         String
  checkin_location Unsupported("geography(Point, 4326)")?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Se marca cuando el caso se libera (por el analista o por el admin):
  // la visita queda como historial, pero deja de contar para el limite
  // de casos activos y su chat se cierra. Quien lo libero importa: que
  // el analista suelte un caso es responsable; que el admin tenga que
  // rescatarlo es una señal de que no cumplio.
  released_at      DateTime?
  released_by_role Role?

  request          PropertyRequests  @relation(fields: [request_id], references: [id])
  volunteer        VolunteerProfiles @relation(fields: [volunteer_id], references: [id])
  visit_note       VisitNotes?
  messages         Messages[]
  abuse_reports    AbuseReports[]
}

// Denuncia del ciudadano sobre el comportamiento del analista (dinero,
// datos, trato, no llego). NO tiene nada que ver con los daños de la
// vivienda: es moderacion de personas.
model AbuseReports {
  id          String   @id @default(uuid())
  visit_id    String
  reporter_id String
  reason      AbuseReason
  details     String?
  reviewed_at DateTime?
  reviewed_by String?
  created_at  DateTime @default(now())

  visit       Visits   @relation(fields: [visit_id], references: [id])

  @@index([created_at(sort: Desc)])
}

// Chat entre el ciudadano y el analista asignado. Existe para que puedan
// cuadrar la visita sin intercambiar telefonos: el numero del ciudadano
// nunca se le entrega al analista. El admin puede leerlo para moderar.
model Messages {
  id          String   @id @default(uuid())
  visit_id    String
  sender_id   String
  sender_role Role
  body        String
  read_at     DateTime?
  created_at  DateTime @default(now())

  visit       Visits   @relation(fields: [visit_id], references: [id])
  sender      Users    @relation(fields: [sender_id], references: [id])

  @@index([visit_id, created_at])
}

// Aviso del admin a un analista ("tu foto no es real", "la matricula no
// coincide"). El analista lo ve al entrar y puede corregir; si no lo
// hace, el admin decide bloquearlo.
model AdminNotices {
  id           String   @id @default(uuid())
  volunteer_id String
  admin_id     String
  body         String
  resolved_at  DateTime?
  created_at   DateTime @default(now())

  volunteer    VolunteerProfiles @relation(fields: [volunteer_id], references: [id])

  @@index([volunteer_id, created_at])
}

// Nota informal de acompañamiento (no un dictamen oficial): por zonas/
// habitaciones, cada una con su propio estado y comentario, mas un campo
// de comentarios generales de la visita completa.
model VisitNotes {
  id               String   @id @default(uuid())
  visit_id         String   @unique
  general_comments String?
  evidence_urls    Json
  created_at       DateTime @default(now())

  visit            Visits           @relation(fields: [visit_id], references: [id])
  zones            VisitNoteZones[]
}

model VisitNoteZones {
  id            String     @id @default(uuid())
  visit_note_id String
  zone_name     String
  status        ZoneStatus
  comment       String?

  visit_note    VisitNotes @relation(fields: [visit_note_id], references: [id])
}

model AuditLogs {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  actor_id    String
  action      String
  resource_id String
  prior_state String?
  new_state   String?
  // Motivo que escribio el admin al actuar. Sin esto, una suspension o
  // un rechazo quedan sin contexto para quien revise despues.
  notes       String?
  ip_address  String?

  @@index([timestamp(sort: Desc)])
  @@index([actor_id])
}
