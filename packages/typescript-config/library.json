{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "ignoreDeprecations": "6.0",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node10",
    "target": "ES2021",
    "lib": ["ES2021"],
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": false,
    "outDir": "dist"
  },
  "exclude": ["node_modules", "dist"]
}
